# ===================================================
# inburi-flood-watch-ai — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าของคุณ
# ===================================================

# --- Make.com ---
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/xxxxxxxxxxxxxxxx
FACEBOOK_PAGE_NAME=รอดมั้ย

# --- Image Hosting ---
# เลือก provider: "imgbb" (แนะนำ) หรือ "cloudinary"

# ImgBB — สมัครฟรีได้ที่ https://api.imgbb.com/

# Cloudinary — ใช้ถ้าเลือก IMAGE_HOST=cloudinary
# pip install cloudinary ก่อนด้วย
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- General ---
TZ=Asia/Bangkok
DRY_RUN=true
SAFE_MODE=true
POST_MIN_CONFIDENCE=60
REQUEST_TIMEOUT_S=20

# --- Water Level ---
INBURI_BANK_LEVEL_MSL=13.00
INBURI_LEVEL_MIN_MSL=8.0
ALERT_COOLDOWN_MINUTES=120

# --- AI Council (optional) ---
AI_COUNCIL_ENABLED=false
IMAGE_HOST=imgbb
IMGBB_API_KEY=90bdd186ac4a75a080d137e88c123b84
